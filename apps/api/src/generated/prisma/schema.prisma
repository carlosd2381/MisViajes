generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SENIOR_AGENT
  AGENT
  OPERATIONS
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  CONVERTED
  LOST
}

enum TripStatus {
  INQUIRY
  RESEARCH
  QUOTED
  REVISED
  APPROVED
  CONFIRMED
  FINALIZED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ItineraryItemType {
  FLIGHT
  HOTEL
  TRANSFER
  ACTIVITY
  CAR_RENTAL
  INSURANCE
  RESTAURANT
  NOTE
}

enum OpportunityStage {
  NEW
  QUOTING
  NEGOTIATING
  BOOKED
  TRAVELING
  POST_TRIP
  LOST
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentMethod {
  SPEI
  CREDIT_CARD
  OXXO
  CASH
  PAYPAL
  MERCADO_PAGO
  STRIPE
  CLIP
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  CREDIT_NOTE
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  SMS
  INTERNAL_NOTE
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum TemplateLanguage {
  ES
  EN
  BILINGUAL
}

enum DocumentCategory {
  CLIENT
  BOOKING
  AGENCY
}

enum DocumentType {
  PASSPORT
  VISA
  VACCINATION
  INSURANCE
  WAIVER
  SUPPLIER_CONFIRMATION
  VOUCHER
  INVOICE
  RECEIPT
  CANCELLATION
  CONTRACT
  RATE_SHEET
  SOP
  OTHER
}

enum DocumentValidationStatus {
  PENDING
  VALID
  EXPIRED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadsAssigned         Lead[]        @relation("LeadAssignedAgent")
  opportunitiesAssigned Opportunity[] @relation("OpportunityAssignedAgent")
  tasksAssigned         Task[]        @relation("TaskAssignedTo")
  tasksCreated          Task[]        @relation("TaskCreatedBy")
}

model Client {
  id              String   @id @default(cuid())
  fullName        String
  email           String?  @unique
  phone           String?
  preferredMethod String? // WhatsApp | Email
  budgetRange     String? // 20k-50k, 50k-100k, 100k+
  travelStyle     String? // solo, couple, family, group, corporate
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads          Lead[]
  trips          Trip[]
  opportunities  Opportunity[]
  payments       Payment[]
  invoices       Invoice[]
  communications Communication[]
  documents      Document[]
}

model Lead {
  id             String     @id @default(cuid())
  source         String
  score          String? // HOT | WARM | COLD
  status         LeadStatus @default(NEW)
  lostReason     String?
  expectedBudget Decimal?
  timeline       String?

  clientId        String
  assignedAgentId String?

  client        Client @relation(fields: [clientId], references: [id])
  assignedAgent User?  @relation("LeadAssignedAgent", fields: [assignedAgentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]
}

model Trip {
  id        String     @id @default(cuid())
  title     String
  status    TripStatus @default(INQUIRY)
  startDate DateTime?
  endDate   DateTime?
  notes     String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  itineraryItems ItineraryItem[]
  opportunities  Opportunity[]
  payments       Payment[]
  invoices       Invoice[]
  communications Communication[]
  documents      Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItineraryItem {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  dayNumber    Int
  startTime    String?
  endTime      String?
  itemType     ItineraryItemType
  title        String
  description  String?
  confirmation String?
  providerName String?
  location     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, dayNumber])
}

model Opportunity {
  id                String           @id @default(cuid())
  title             String
  stage             OpportunityStage @default(NEW)
  dealValue         Decimal?
  probability       Int?
  expectedCloseDate DateTime?
  competitorNotes   String?

  clientId        String
  leadId          String?
  tripId          String?
  assignedAgentId String?

  client        Client @relation(fields: [clientId], references: [id])
  lead          Lead?  @relation(fields: [leadId], references: [id])
  trip          Trip?  @relation(fields: [tripId], references: [id])
  assignedAgent User?  @relation("OpportunityAssignedAgent", fields: [assignedAgentId], references: [id])

  quotes Quote[]
  tasks  Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, stage])
}

model Quote {
  id            String    @id @default(cuid())
  opportunityId String
  version       Int
  title         String?
  amount        Decimal?
  expiresAt     DateTime?
  notes         String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, version])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)

  relatedType String?
  relatedId   String?

  opportunityId String?
  assignedToId  String
  createdById   String?

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedTo  User         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy   User?        @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, status])
}

model Payment {
  id        String        @id @default(cuid())
  tripId    String
  clientId  String
  amount    Decimal
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  dueDate   DateTime?
  paidAt    DateTime?
  reference String?
  notes     String?

  trip   Trip   @relation(fields: [tripId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
}

model Invoice {
  id       String        @id @default(cuid())
  tripId   String
  clientId String
  status   InvoiceStatus @default(DRAFT)
  rfc      String?
  cfdiUse  String?
  folio    String?
  uuid     String?
  subtotal Decimal?
  iva      Decimal?
  total    Decimal?
  issuedAt DateTime?
  dueDate  DateTime?
  paidAt   DateTime?
  pdfUrl   String?
  notes    String?

  trip   Trip   @relation(fields: [tripId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, issuedAt])
}

model Communication {
  id          String                 @id @default(cuid())
  clientId    String
  tripId      String?
  channel     CommunicationChannel
  direction   CommunicationDirection @default(OUTBOUND)
  language    TemplateLanguage       @default(ES)
  subject     String?
  message     String
  templateKey String?
  externalId  String?
  openedAt    DateTime?
  sentAt      DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])

  @@index([clientId, channel, createdAt])
}

model MessageTemplate {
  id        String               @id @default(cuid())
  key       String               @unique
  name      String
  channel   CommunicationChannel
  language  TemplateLanguage     @default(BILINGUAL)
  subject   String?
  body      String
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([channel, isActive])
}

model Document {
  id               String                   @id @default(cuid())
  clientId         String?
  tripId           String?
  category         DocumentCategory
  docType          DocumentType
  validationStatus DocumentValidationStatus @default(PENDING)
  title            String
  fileName         String
  fileUrl          String
  expiresAt        DateTime?
  uploadedAt       DateTime                 @default(now())
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
  trip   Trip?   @relation(fields: [tripId], references: [id])

  @@index([category, docType, validationStatus])
  @@index([clientId, tripId])
}
