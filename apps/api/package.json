{
  "name": "@misviajes/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:sync-dist": "mkdir -p dist/generated && rm -rf dist/generated/prisma && cp -R src/generated/prisma dist/generated/prisma",
    "prestart:dev": "pnpm run prisma:sync-dist",
    "start:dev": "nest start --watch",
    "build": "rm -rf dist tsconfig.tsbuildinfo && nest build && pnpm run prisma:sync-dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prestart": "pnpm run prisma:sync-dist",
    "start": "node dist/main",
    "smoke:ready": "SMOKE_WITH_AUTH=0 node scripts/smoke-ready.cjs",
    "smoke:auth": "SMOKE_WITH_AUTH=1 node scripts/smoke-ready.cjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.0.11",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nestjs/cli": "11.0.7",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.0.11",
    "@types/node": "22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "9.22.0",
    "prettier": "3.5.3",
    "prisma": "^6.16.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  }
}
